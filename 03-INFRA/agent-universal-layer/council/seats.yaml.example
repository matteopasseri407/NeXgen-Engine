# Template del piano dati utente per il Consiglio delle AI.
#
# Il motore pubblico non prescrive QUALI modelli usare: la scelta dipende
# dagli abbonamenti che hai, da cosa esce ogni mese come frontier, dal
# budget. Questo file è solo lo schema + i criteri generali; le scelte vere
# vivono nel tuo piano dati (fuori dal motore, mai committato qui), di
# default in:
#   $AGENT_VAULT_DATA/03-INFRA/agent-universal-layer/council/seats.yaml
# (AGENT_VAULT_DATA non impostata => $KNOWLEDGE_VAULT_PATH => ~/KnowledgeVault,
# stesso pattern di AGENT_ENGINE_ROOT/AGENT_VAULT_DATA usato da agent_sync.py).
#
# Senza un seats.yaml valido in quel percorso, `council` si ferma e spiega
# cosa manca: l'espansione è disattivata di default, zero dipendenze forzate.
#
# Piccolo team, più seat file (opzionale, retrocompatibile al 100%):
# per default resta un solo seats.yaml condiviso, esattamente come sopra.
# Se più persone vogliono i propri seat senza contendersi lo stesso file,
# due override puramente opzionali, in quest'ordine:
#   1. COUNCIL_SEATS_FILE=/percorso/assoluto/ai/tuoi/seats.yaml
#      path esplicito, vince su tutto il resto.
#   2. AGENT_TEAM_MEMBER=<nome>
#      lo stesso identificatore dichiarato in
#      99-INDEX/USER-PROFILE.md -> "Team members (optional)"; risolve a
#      seats.<nome>.yaml accanto al seats.yaml di default, es.
#      $AGENT_VAULT_DATA/.../council/seats.marco.yaml per AGENT_TEAM_MEMBER=marco.
# Nessuna delle due viene letta se non e' impostata: chi ha gia' un
# seats.yaml singolo non nota alcuna differenza.
#
# Criteri generali per scegliere i seat (non i modelli specifici):
#   - preferisci CLI gia' coperte da un abbonamento flat esistente, mai una
#     nuova API a consumo aperta solo per questo; ogni seat consultato spende
#     la quota del proprio canale;
#   - il vendor di un seat consultato deve essere diverso dal vendor che ha
#     prodotto il materiale in esame (niente auto-review dello stesso vendor);
#   - preferisci seat con garanzia zero-retention per materiale reale;
#     Council mostra un WARNING per i seat senza garanzia, ma non li blocca;
#   - verifica la policy dati del canale con una fonte primaria (pagina
#     privacy/ToS del provider), non fidarti di riassunti di terzi.
#
# Schema di ogni seat:
#   <nome-seat>:
#     vendor: <vendor del modello, es. openai/anthropic/deepseek/zhipu/...>
#     cli: <CLI locale che lo invoca in headless, es. opencode/agy/codex/claude/ollama>
#     model: <identificatore modello nel formato atteso dalla CLI>
#     routing_id: <id canonico nel documento di decisione>       # opzionale
#     routing_label: <nome umano esatto nel documento di decisione> # opzionale
#     reasoning_effort: low|medium|high|xhigh|max|none           # opzionale
#     quota_pool: <pool reale condiviso, es. opencode-go>  # opzionale ma consigliato
#     timeout_seconds: 300  # opzionale, default conservativo: 300 secondi
#     zero_retention: true|false   # metadato verificato con fonte primaria;
#                                  # false produce un WARNING, non un blocco
#
# Schema sequence per il mode `relay`:
# - i ruoli NON vivono dentro i seat;
# - la sequence dichiara ruolo -> seat primario e fallback ammessi;
# - i fallback validi per un ruolo sono SOLO quelli dichiarati qui.
#
# Puoi anche passare una sequence inline:
#   council relay "brief" --sequence architect=seat-a|seat-b,builder=seat-c,reviewer=seat-d
# oppure definire sequence nominate:
#
# sequences:
#   default:
#     - role: architect
#       seats: [seat-a, seat-b]  # seat-b e' fallback esplicito, non improvvisato
#     - role: builder
#       seat: seat-c
#     - role: reviewer
#       seat: seat-d
#
# Proposta di routing da un documento privato di decisione:
# - Council funziona anche senza Governor: usa i seat dichiarati e lascia
#   sempre la scelta all'umano;
# - integrazione opzionale pronta per il Governor pubblico:
#   https://github.com/matteopasseri407/neXgen-addon-llm-model-routing-governor
# - se attivo, Council legge soltanto il documento dichiarato nel Vault e propone
#   il modello concreto qui dichiarato; non esegue mai un seat senza --seat o
#   una relay senza --sequence scelti esplicitamente dall'umano;
# - ogni seat proponibile deve avere routing_id e/o routing_label, oltre a model
#   ed effort esatti per la sua CLI;
# - le tabelle per ruolo del Governor portano Modello + CLI. Questa coppia
#   distingue lo stesso modello esposto da pool diversi. Un vecchio documento
#   senza CLI viene rifiutato solo quando il mapping sarebbe ambiguo;
# - la CLI viene interrogata in sola lettura quando espone un inventario locale.
#   Un modello non verificabile o assente viene mostrato come escluso, non viene
#   sostituito o invocato automaticamente. zero_retention=false resta proponibile
#   con un WARNING visibile.
#
# routing:
#   enabled: true
#   decision_file: path/privato/routing.md
#   mode_defaults:
#     brainstorm: L-Arch
#     challenge: L-Arch
#     code-review: L-Code
#   # Questi sono ruoli da proporre, non default di esecuzione.
#   relay_roles: [L-Arch, L-Build, L-Code]

# Campo root obbligatorio, aggiornalo solo con una migrazione documentata.
schema_version: 1

seats:
  esempio-seat:
    vendor: nome-vendor
    # a differenza di vendor/model (testo libero), cli e' validato contro un
    # insieme fisso -- deve essere una delle CLI locali supportate:
    # opencode, agy, codex, claude, ollama (vedi config_schema.COUNCIL_CLIS).
    cli: codex
    model: provider/nome-modello
    quota_pool: nome-cli-provider
    zero_retention: false
